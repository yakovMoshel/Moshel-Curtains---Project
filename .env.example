# EmailJS (https://www.emailjs.com) — used client-side by the contact form.
# Copy this file to .env.local and fill in the real values.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# OpenAI (server-only — used by src/app/api/visualize/route.ts for AI photo visualization)
OPENAI_API_KEY=
